rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff sign in with real Firebase Authentication (email/password) now -
    // there's no separate anonymous handshake anymore. This rule requires
    // that real sign-in to have happened before any read/write is allowed,
    // which stops randoms with your public apiKey from reading/writing your
    // data directly against the Firestore API, while still letting your app
    // work normally for anyone actually logged in.
    //
    // Everything EXCEPT the two license collections below is open to any
    // signed-in user, exactly as before.
    match /{col}/{docId=**} {
      allow read, write: if request.auth != null && col != 'licenses' && col != 'licenseFiles';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Uploaded licenses/certificates (metadata + file data). Private: readable
    // only by the staff member who uploaded them and by admins. Only the owner
    // can create or change one; owner or admin can delete (admin delete is used
    // when a user is removed).
    match /licenses/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /licenseFiles/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
